{
  "name": "nextjs-graphql-template",
  "packageManager": "pnpm@10.14.0",
  "author": "codyd",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:spotlight": "pnpm dlx @spotlightjs/spotlight",
    "dev:next": "next dev --turbopack",
    "dev": "run-p dev:next codegen:watch",
    "build:next": "next build",
    "build": "node scripts/build.js",
    "build:ci": "pnpm run build:next",
    "build:prod": "cross-env NODE_ENV=production pnpm run build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true pnpm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "commit": "commit",
    "bootstrap": "tsx scripts/init/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "codegen": "node scripts/codegen-with-retry.js",
    "codegen:watch": "node scripts/codegen-with-retry.js --watch"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@apollo/server": "^5.5.1",
    "@as-integrations/next": "^4.1.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@clerk/localizations": "^3.37.9",
    "@clerk/nextjs": "^6.39.7",
    "@hookform/resolvers": "^5.9.1",
    "@logtape/logtape": "^1.3.11",
    "@react-email/render": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-toastify": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "svix": "^1.99.1",
    "type-graphql": "^2.0.0-rc.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/prompt-cli": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint-react/eslint-plugin": "^2.11.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^3.2.2",
    "@next/bundle-analyzer": "^16.3.6",
    "@next/eslint-plugin-next": "^16.3.6",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.63.0",
    "@spotlightjs/spotlight": "^3.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "lefthook": "^1.13.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "semantic-release": "^24.2.7",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "effect": ">=3.20.0",
      "esbuild": ">=0.24.3",
      "immutable": ">=3.8.3"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
