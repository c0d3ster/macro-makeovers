# Copy to .env.local for local overrides. Hosted values are set in Vercel's environment variables.

# Optional: rebuild the recipe book PDF when a published recipe changes.
# Fine-grained personal access token limited to this repository, with only
# "Contents: Read and write" (required for repository_dispatch). Leave unset to skip rebuilds.
GITHUB_DISPATCH_TOKEN=
# owner/name
GITHUB_REPO=c0d3ster/macro-makeovers

# Email goes out through Resend from hello@macromakeovers.com (a domain on the c0d3ster team).
# SUPPORT_EMAIL is where makeover ideas from the about page go, and defaults to hello@.
RESEND_API_KEY=
SUPPORT_EMAIL=

# Placeholder photos and the recipe book photos live in Cloudflare R2.
OPENAI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (r2.dev or a custom domain)
R2_PUBLIC_URL=

# Grocery handoff ("Send to cart", PRD 05). Ships dark: the button stays a placeholder until
# GROCERY_HANDOFF_ENABLED is "true", and each grocer only shows once its keys are set.
GROCERY_HANDOFF_ENABLED=
# 32+ random characters. Seals members' Kroger tokens into an httpOnly cookie.
GROCERY_TOKEN_SECRET=
# Instacart Developer Platform key. INSTACART_API_URL defaults to production; set it to
# https://connect.dev.instacart.tools for a development key.
INSTACART_API_KEY=
INSTACART_API_URL=
# Kroger developer app (scopes product.compact and cart.basic:write). Register the redirect URI
# <NEXT_PUBLIC_APP_URL>/api/grocery/kroger/callback.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Walmart's cart link needs no key, only item ids in src/libs/grocery/itemMappings.ts.
# WALMART_AFFILIATE_LINK is an optional Impact tracking link that wraps it.
WALMART_ENABLED=
WALMART_AFFILIATE_LINK=
