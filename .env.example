# Copy to .env.local for local overrides. Hosted values are set in Vercel's environment variables.

# Optional: rebuild the recipe book PDF when a published recipe changes.
# Fine-grained personal access token limited to this repository, with only
# "Contents: Read and write" (required for repository_dispatch). Leave unset to skip rebuilds.
GITHUB_DISPATCH_TOKEN=
# owner/name
GITHUB_REPO=c0d3ster/macro-makeovers

# Email goes out through Resend from hello@macromakeovers.com (a domain on the c0d3ster team).
# The contact form stays hidden until CONTACT_FORM_ENABLED is "true". SUPPORT_EMAIL is where its
# messages go, and defaults to hello@macromakeovers.com.
RESEND_API_KEY=
CONTACT_FORM_ENABLED=
SUPPORT_EMAIL=

# Placeholder photos and the recipe book photos live in Cloudflare R2.
OPENAI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (r2.dev or a custom domain)
R2_PUBLIC_URL=
