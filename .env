# Supabase
# Local: run `pnpm run db:start` (needs Docker). The defaults below point at that stack.
# Secret key: add SUPABASE_SECRET_KEY to .env.local (see `pnpm exec supabase status`). Never commit it.
# Hosted: https://supabase.com → Dashboard → Project Settings → API Keys, set in Vercel's environment variables


# Local development defaults (Supabase Docker stack, `pnpm db:start`).
# These are the standard demo values the Supabase CLI prints for every local stack.
# Hosted values are set in Vercel's environment variables, which override these.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Next.js
NEXT_TELEMETRY_DISABLED=1